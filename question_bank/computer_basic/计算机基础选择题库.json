      "question": "二进制数1010转换为十进制数是？",
      "options": {
        "A": "8",
        "B": "10",
        "C": "12",
        "D": "14"
      },
      "answer": "B",
      "explanation": "二进制1010 = 1×2³ + 0×2² + 1×2¹ + 0×2⁰ = 8 + 0 + 2 + 0 = 10。"
    },
